{
  "description": "Humanize RLCR Codex lifecycle hook",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/rlcr.py\" hook",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\rlcr.py\" hook",
            "timeout": 1800,
            "statusMessage": "Running independent RLCR reviewers"
          }
        ]
      }
    ]
  }
}
