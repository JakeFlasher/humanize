{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Humanize RLCR structured plan contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "goal", "criteria"],
  "properties": {
    "schema_version": {"type": "string", "const": "rlcr.plan.v1"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 8000},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "required", "required_checks"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "required": {"type": "boolean"},
          "required_checks": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          }
        }
      }
    }
  }
}
